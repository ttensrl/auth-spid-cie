#. Plugin Name of the plugin
#: auth-spid-cie.php
msgid "Auth SPID CIE"
msgstr "Auth SPID CIE"

#. Description of the plugin
#: auth-spid-cie.php
msgid "Standalone SPID and CIE login (SAML 2.0 Service Provider) with no external dependencies."
msgstr "Accesso con SPID e CIE (Service Provider SAML 2.0) autonomo, senza dipendenze esterne."

#. translators: %s: current PHP version.
#: auth-spid-cie.php:55
#, php-format
msgid "The plugin requires PHP 8.0 or higher. Your current version is %s."
msgstr "Il plugin richiede PHP 8.0 o superiore. La tua versione attuale è %s."

