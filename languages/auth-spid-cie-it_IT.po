msgstr ""
"Certificati del gestore di identità non disponibili: accesso temporaneamente "
"non possibile."

#: includes/Http/Router.php:172
msgid "SSO endpoint not available for this identity provider."
msgstr "Endpoint SSO non disponibile per questo gestore di identità."

#: includes/Http/Router.php:194
msgid "Unable to start authentication. Please contact the site administrator."
msgstr ""
"Impossibile avviare l'autenticazione. Contattare l'amministratore del sito."

#: includes/Http/Router.php:201
msgid "Method not allowed."
msgstr "Metodo non consentito."

#: includes/Http/Router.php:205
msgid "SAML response missing."
msgstr "Risposta SAML mancante."

#: includes/Http/Router.php:211
msgid "The response cannot be matched to any request."
msgstr "Risposta non associabile ad alcuna richiesta."

#: includes/Http/Router.php:215
msgid "Login request expired or already used. Please try again."
msgstr "Richiesta di accesso scaduta o già utilizzata. Riprovare."

#: includes/Http/Router.php:220
msgid "Identity provider not recognized."
msgstr "Gestore di identità non riconosciuto."

#: includes/Http/Router.php:259
msgid "Error during authentication. Please try again."
msgstr "Errore durante l'autenticazione. Riprovare."

#: includes/Http/Router.php:267
msgid "Authentication failed after repeated submission of wrong credentials."
msgstr ""
"Autenticazione fallita per ripetuta sottomissione di credenziali errate."

#: includes/Http/Router.php:268
msgid ""
"No credentials compatible with the level required by the service are "
"available."
msgstr ""
"Non sono disponibili credenziali compatibili con il livello richiesto dal "
"servizio."

#: includes/Http/Router.php:269
msgid "Timeout during authentication."
msgstr "Timeout durante l'autenticazione."

#: includes/Http/Router.php:270
msgid "Consent to send the data was not given."
msgstr "Consenso all'invio dei dati non concesso."

#: includes/Http/Router.php:271
msgid "Identity suspended or revoked, or credentials blocked."
msgstr "Identità sospesa o revocata, oppure credenziali bloccate."

#: includes/Http/Router.php:272
msgid "Authentication cancelled."
msgstr "Autenticazione annullata."

#: includes/Http/Router.php:278
msgid "Authentication failed at the identity provider."
msgstr "Autenticazione non riuscita presso il gestore di identità."

#: includes/Http/Router.php:281
msgid ""
"The security level of the digital identity is not sufficient for this "
"service."
msgstr ""
"Il livello di sicurezza dell'identità digitale non è sufficiente per questo "
"servizio."

#: includes/Http/Router.php:284
msgid "The authentication response has expired. Please try again."
msgstr "La risposta di autenticazione è scaduta. Riprovare."

#: includes/Http/Router.php:286
msgid "Unable to verify the authentication response. Please try again."
msgstr "Impossibile verificare la risposta di autenticazione. Riprovare."

#: includes/Http/Router.php:310
msgid ""
"Metadata not available: generate the Service Provider certificate first."
msgstr ""
"Metadata non disponibile: generare prima il certificato del Service Provider."

